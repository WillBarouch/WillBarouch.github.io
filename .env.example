# Sanity CMS — copy this file to .env.local and fill in your values.
# Find the project ID in https://www.sanity.io/manage (or via `npx sanity init`).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token (Editor role) — used ONLY by `npm run seed`. Never shipped to the client.
# Create one at: Manage → API → Tokens.
SANITY_API_WRITE_TOKEN=
